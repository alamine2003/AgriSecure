# DJANGO CONFIG
DJANGO_SECRET_KEY=changeme-50-chars-minimum-for-production-security
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,nginx,backend

# DATABASE CONFIG
POSTGRES_DB=surveillance_db
POSTGRES_USER=surveillance_user
POSTGRES_PASSWORD=StrongPass123!
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# REDIS CONFIG
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=RedisPass456!

# JWT CONFIG
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# PGADMIN CONFIG
PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=PgAdmin789!

# CELERY / FLOWER CONFIG
FLOWER_USER=flower_admin
FLOWER_PASSWORD=Flower321!

# MINIO CONFIG (simplifié)
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=Minio654!
MINIO_BUCKET_DETECTIONS=detections
MINIO_ENDPOINT=minio:9000
# Les variables ACCESS_KEY/SECRET_KEY sont automatiquement dérivées de ROOT_USER/ROOT_PASSWORD

# EMAIL CONFIG
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# CAMERA & IA CONFIG
VIDEO_DEVICE=/dev/video0
ALERT_COOLDOWN_SECONDS=15
CAMERA_INDEX=0
CAMERA_FPS=15
YOLO_CONFIDENCE_THRESHOLD=0.5
YOLO_CACHE_TTL_SECONDS=30
YOLO_SIMILARITY_THRESHOLD=0.85
DANGER_HIGH_CLASSES=person
DANGER_MEDIUM_CLASSES=cow,goat,horse
DANGER_LOW_CLASSES=bird,cat,dog

# MONITORING CONFIG
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin123!
SERVICE_NAME=surveillance-backend
ENVIRONMENT=development
APP_VERSION=1.0.0
LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=INFO
CAMERA_LOG_LEVEL=INFO
AI_LOG_LEVEL=INFO
SURVEILLANCE_LOG_LEVEL=INFO
CELERY_LOG_LEVEL=INFO
CHANNELS_LOG_LEVEL=INFO
