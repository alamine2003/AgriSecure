import React from 'react';
import { useQuery } from '@tanstack/react-query';
import client from '../api/client';
import {
  Users, UserPlus, UserCheck, UserX, Calendar, Camera,
  AlertTriangle, TrendingUp, Activity, Clock, CheckCircle,
  XCircle, Eye, Shield, Zap, Target
} from 'lucide-react';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';
import { Badge } from '@/components/ui/badge';

export default function MaintenancierDashboard() {
  // Fetch KPIs
  const { data: kpi, isLoading: kpiLoading } = useQuery({
    queryKey: ['maintenancier-kpi'],
    queryFn: async () => {
      const res = await client.get('/surveillance/maintenancier-stats/kpi/');
      return res.data;
    },
    refetchInterval: 30000, // Refresh toutes les 30s
  });

  // Fetch activités récentes
  const { data: activities, isLoading: activitiesLoading } = useQuery({
    queryKey: ['audit-logs'],
    queryFn: async () => {
      const res = await client.get('/surveillance/audit-logs/?limit=15');
      return Array.isArray(res.data) ? res.data : res.data?.results || [];
    },
  });

  // Fetch tendances (7 derniers jours)
  const { data: trends } = useQuery({
    queryKey: ['maintenancier-trends'],
    queryFn: async () => {
      const res = await client.get('/surveillance/maintenancier-stats/trends/');
      return res.data;
    },
  });

  if (kpiLoading) {
    return (
      <div className="flex items-center justify-center min-h-screen">
        <div className="text-center">
          <Activity className="w-12 h-12 mx-auto mb-4 animate-pulse text-green-600" />
          <p className="text-muted-foreground">Chargement du dashboard...</p>
        </div>
      </div>
    );
  }

  const mainKPIs = [
    {
      title: "Agents Actifs",
      value: kpi?.agents?.active || 0,
      total: kpi?.agents?.total || 0,
      icon: <Users className="w-6 h-6" />,
      gradient: "from-blue-500 to-blue-600",
      bgGradient: "from-blue-50 to-blue-100",
      change: "+12%",
      trend: "up"
    },
    {
      title: "Demandes en Attente",
      value: kpi?.requests?.pending || 0,
      total: kpi?.requests?.total || 0,
      icon: <UserPlus className="w-6 h-6" />,
      gradient: "from-yellow-500 to-yellow-600",
      bgGradient: "from-yellow-50 to-yellow-100",
      change: "3 nouvelles",
      trend: "neutral"
    },
    {
      title: "Caméras Actives",
      value: kpi?.cameras?.active || 0,
      total: kpi?.cameras?.total || 0,
      icon: <Camera className="w-6 h-6" />,
      gradient: "from-green-500 to-green-600",
      bgGradient: "from-green-50 to-green-100",
      change: "+8%",
      trend: "up"
    },
    {
      title: "Alertes Critiques",
      value: kpi?.alerts?.critical || 0,
      icon: <AlertTriangle className="w-6 h-6" />,
      gradient: "from-red-500 to-red-600",
      bgGradient: "from-red-50 to-red-100",
      change: "-5%",
      trend: "down"
    }
  ];

  const secondaryKPIs = [
    {
      label: "RDV Planifiés",
      value: kpi?.appointments?.pending || 0,
      icon: <Calendar className="w-5 h-5 text-purple-600" />,
      color: "bg-purple-100 text-purple-700"
    },
    {
      label: "Demandes Approuvées",
      value: kpi?.requests?.approved || 0,
      icon: <CheckCircle className="w-5 h-5 text-green-600" />,
      color: "bg-green-100 text-green-700"
    },
    {
      label: "Demandes Rejetées",
      value: kpi?.requests?.rejected || 0,
      icon: <XCircle className="w-5 h-5 text-red-600" />,
      color: "bg-red-100 text-red-700"
    },
    {
      label: "Détections / 7j",
      value: kpi?.detections?.weekly || 0,
      icon: <Eye className="w-5 h-5 text-indigo-600" />,
      color: "bg-indigo-100 text-indigo-700"
    }
  ];

  const getActionIcon = (action) => {
    const icons = {
      'CREATE_AGENT': <UserPlus className="w-4 h-4" />,
      'UPDATE_AGENT': <Users className="w-4 h-4" />,
      'DELETE_AGENT': <UserX className="w-4 h-4" />,
      'ACTIVATE_AGENT': <UserCheck className="w-4 h-4" />,
      'DEACTIVATE_AGENT': <UserX className="w-4 h-4" />,
      'APPROVE_REQUEST': <CheckCircle className="w-4 h-4" />,
      'REJECT_REQUEST': <XCircle className="w-4 h-4" />,
      'CREATE_APPOINTMENT': <Calendar className="w-4 h-4" />,
    };
    return icons[action] || <Activity className="w-4 h-4" />;
  };

  const getActionColor = (action) => {
    if (action.includes('CREATE') || action.includes('APPROVE')) return 'text-green-600 bg-green-50';
    if (action.includes('DELETE') || action.includes('REJECT')) return 'text-red-600 bg-red-50';
    if (action.includes('UPDATE')) return 'text-blue-600 bg-blue-50';
    return 'text-gray-600 bg-gray-50';
  };

  const formatTimeAgo = (dateString) => {
    const date = new Date(dateString);
    const now = new Date();
    const seconds = Math.floor((now - date) / 1000);

    if (seconds < 60) return 'À l\'instant';
    if (seconds < 3600) return `Il y a ${Math.floor(seconds / 60)} min`;
    if (seconds < 86400) return `Il y a ${Math.floor(seconds / 3600)}h`;
    return `Il y a ${Math.floor(seconds / 86400)}j`;
  };

  return (
    <div className="space-y-6">
      {/* Header */}
      <div className="flex items-center justify-between">
        <div>
          <h1 className="text-3xl font-bold tracking-tight bg-gradient-to-r from-gray-900 to-gray-700 bg-clip-text text-transparent">
            Dashboard Maintenancier
          </h1>
          <p className="text-muted-foreground mt-1">
            Vue d'ensemble et statistiques en temps réel
          </p>
        </div>
        <div className="flex items-center gap-2">
          <Badge variant="outline" className="flex items-center gap-2 px-3 py-2">
            <Activity className="w-4 h-4 text-green-600 animate-pulse" />
            <span>Système Opérationnel</span>
          </Badge>
        </div>
      </div>

      {/* Bento Grid - Main KPIs */}
      <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        {mainKPIs.map((kpi, index) => (
          <Card key={index} className="relative overflow-hidden group hover:shadow-xl transition-all duration-300 border-0">
            {/* Gradient Background */}
            <div className={`absolute inset-0 bg-gradient-to-br ${kpi.bgGradient} opacity-50`} />

            <CardContent className="relative p-6">
              {/* Icon */}
              <div className={`w-14 h-14 rounded-2xl bg-gradient-to-br ${kpi.gradient} flex items-center justify-center text-white mb-4 shadow-lg group-hover:scale-110 transition-transform`}>
                {kpi.icon}
              </div>

              {/* Value */}
              <div className="space-y-1">
                <p className="text-sm font-medium text-gray-600">{kpi.title}</p>
                <div className="flex items-baseline gap-2">
                  <h3 className="text-4xl font-bold text-gray-900">{kpi.value}</h3>
                  {kpi.total && (
                    <span className="text-lg text-gray-500">/ {kpi.total}</span>
                  )}
                </div>

                {/* Trend */}
                {kpi.change && (
                  <div className={`flex items-center gap-1 text-xs font-medium ${
                    kpi.trend === 'up' ? 'text-green-600' :
                    kpi.trend === 'down' ? 'text-red-600' :
                    'text-gray-600'
                  }`}>
                    <TrendingUp className="w-3 h-3" />
                    {kpi.change}
                  </div>
                )}
              </div>
            </CardContent>
          </Card>
        ))}
      </div>

      {/* Secondary KPIs */}
      <div className="grid grid-cols-2 md:grid-cols-4 gap-4">
        {secondaryKPIs.map((item, index) => (
          <Card key={index} className="border-0 shadow-sm hover:shadow-md transition-shadow">
            <CardContent className="p-4">
              <div className="flex items-center justify-between">
                <div>
                  <p className="text-xs text-muted-foreground mb-1">{item.label}</p>
                  <p className="text-2xl font-bold">{item.value}</p>
                </div>
                <div className={`w-10 h-10 rounded-xl ${item.color} flex items-center justify-center`}>
                  {item.icon}
                </div>
              </div>
            </CardContent>
          </Card>
        ))}
      </div>

      {/* Bento Grid - Bottom Section */}
      <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
        {/* Activités Récentes - 2/3 */}
        <Card className="lg:col-span-2 border-0 shadow-lg">
          <CardHeader>
            <div className="flex items-center justify-between">
              <div>
                <CardTitle className="flex items-center gap-2">
                  <Activity className="w-5 h-5 text-green-600" />
                  Activités Récentes
                </CardTitle>
                <CardDescription>Historique de vos actions</CardDescription>
              </div>
              <Badge variant="secondary">{activities?.length || 0} actions</Badge>
            </div>
          </CardHeader>
          <CardContent>
            <div className="space-y-3 max-h-[400px] overflow-y-auto pr-2">
              {activitiesLoading ? (
                <div className="text-center py-8 text-muted-foreground">
                  <Activity className="w-8 h-8 mx-auto mb-2 animate-pulse" />
                  Chargement...
                </div>
              ) : activities && activities.length > 0 ? (
                activities.map((log, index) => (
                  <div key={log.id || index} className="flex items-start gap-3 p-3 rounded-lg hover:bg-secondary/50 transition-colors group">
                    {/* Icon */}
                    <div className={`w-8 h-8 rounded-lg ${getActionColor(log.action)} flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform`}>
                      {getActionIcon(log.action)}
                    </div>

                    {/* Content */}
                    <div className="flex-1 min-w-0">
                      <p className="text-sm font-medium text-gray-900">
                        {log.action_display}
                      </p>
                      <p className="text-xs text-muted-foreground truncate">
                        {log.target_name}
                      </p>
                      <p className="text-xs text-muted-foreground mt-1">
                        par {log.user_name} • {formatTimeAgo(log.created_at)}
                      </p>
                    </div>
                  </div>
                ))
              ) : (
                <div className="text-center py-8 text-muted-foreground">
                  <Shield className="w-12 h-12 mx-auto mb-2 opacity-50" />
                  <p>Aucune activité récente</p>
                </div>
              )}
            </div>
          </CardContent>
        </Card>

        {/* Stats Rapides - 1/3 */}
        <Card className="border-0 shadow-lg">
          <CardHeader>
            <CardTitle className="flex items-center gap-2">
              <Target className="w-5 h-5 text-purple-600" />
              Statistiques Rapides
            </CardTitle>
            <CardDescription>Vue synthétique</CardDescription>
          </CardHeader>
          <CardContent>
            <div className="space-y-4">
              {/* Taux d'approbation */}
              <div>
                <div className="flex justify-between text-sm mb-2">
                  <span className="text-muted-foreground">Taux d'approbation</span>
                  <span className="font-semibold">
                    {kpi?.requests?.total > 0
                      ? Math.round((kpi.requests.approved / kpi.requests.total) * 100)
                      : 0}%
                  </span>
                </div>
                <div className="w-full bg-gray-200 rounded-full h-2 overflow-hidden">
                  <div
                    className="bg-gradient-to-r from-green-500 to-green-600 h-full rounded-full transition-all duration-500"
                    style={{
                      width: `${kpi?.requests?.total > 0
                        ? (kpi.requests.approved / kpi.requests.total) * 100
                        : 0}%`
                    }}
                  />
                </div>
              </div>

              {/* Agents actifs */}
              <div>
                <div className="flex justify-between text-sm mb-2">
                  <span className="text-muted-foreground">Agents actifs</span>
                  <span className="font-semibold">
                    {kpi?.agents?.total > 0
                      ? Math.round((kpi.agents.active / kpi.agents.total) * 100)
                      : 0}%
                  </span>
                </div>
                <div className="w-full bg-gray-200 rounded-full h-2 overflow-hidden">
                  <div
                    className="bg-gradient-to-r from-blue-500 to-blue-600 h-full rounded-full transition-all duration-500"
                    style={{
                      width: `${kpi?.agents?.total > 0
                        ? (kpi.agents.active / kpi.agents.total) * 100
                        : 100}%`
                    }}
                  />
                </div>
              </div>

              {/* Caméras actives */}
              <div>
                <div className="flex justify-between text-sm mb-2">
                  <span className="text-muted-foreground">Caméras actives</span>
                  <span className="font-semibold">
                    {kpi?.cameras?.total > 0
                      ? Math.round((kpi.cameras.active / kpi.cameras.total) * 100)
                      : 0}%
                  </span>
                </div>
                <div className="w-full bg-gray-200 rounded-full h-2 overflow-hidden">
                  <div
                    className="bg-gradient-to-r from-green-500 to-green-600 h-full rounded-full transition-all duration-500"
                    style={{
                      width: `${kpi?.cameras?.total > 0
                        ? (kpi.cameras.active / kpi.cameras.total) * 100
                        : 0}%`
                    }}
                  />
                </div>
              </div>

              {/* Actions rapides */}
              <div className="pt-4 border-t space-y-2">
                <p className="text-sm font-medium mb-3">Actions Rapides</p>
                <button className="w-full text-left px-3 py-2 rounded-lg hover:bg-secondary transition-colors text-sm flex items-center gap-2">
                  <UserPlus className="w-4 h-4 text-green-600" />
                  Créer un agent
                </button>
                <button className="w-full text-left px-3 py-2 rounded-lg hover:bg-secondary transition-colors text-sm flex items-center gap-2">
                  <Calendar className="w-4 h-4 text-blue-600" />
                  Planifier RDV
                </button>
                <button className="w-full text-left px-3 py-2 rounded-lg hover:bg-secondary transition-colors text-sm flex items-center gap-2">
                  <Eye className="w-4 h-4 text-purple-600" />
                  Voir rapports
                </button>
              </div>
            </div>
          </CardContent>
        </Card>
      </div>
    </div>
  );
}
