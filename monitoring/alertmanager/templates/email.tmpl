{{ define "agriwatch.email.html" }}
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AgriWatch Alert</title>
<style>
  body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; margin: 0; padding: 0; background: #f3f4f6; }
  .container { max-width: 680px; margin: 20px auto; background: #1a1a2e; border-radius: 12px; overflow: hidden; }
  .header { background: linear-gradient(135deg, #f59e0b, #d97706); padding: 24px 32px; }
  .header h1 { color: #fff; margin: 0; font-size: 22px; font-weight: 700; }
  .header p { color: rgba(255,255,255,0.85); margin: 4px 0 0; font-size: 13px; }
  .body { padding: 24px 32px; }
  .alert-card { background: #16213e; border-radius: 10px; padding: 20px; margin-bottom: 16px; border-left: 4px solid #6b7280; }
  .alert-card.critical { border-left-color: #ef4444; }
  .alert-card.warning { border-left-color: #f59e0b; }
  .alert-card.info { border-left-color: #3b82f6; }
  .badge { display: inline-block; padding: 3px 10px; border-radius: 20px; font-size: 11px; font-weight: 700; text-transform: uppercase; margin-bottom: 8px; }
  .badge-critical { background: rgba(239,68,68,0.2); color: #ef4444; }
  .badge-warning { background: rgba(245,158,11,0.2); color: #f59e0b; }
  .badge-info { background: rgba(59,130,246,0.2); color: #3b82f6; }
  .badge-resolved { background: rgba(16,185,129,0.2); color: #10b981; }
  .alert-title { color: #f1f5f9; font-size: 16px; font-weight: 600; margin: 0 0 8px; }
  .alert-desc { color: #94a3b8; font-size: 14px; margin: 0; line-height: 1.5; }
  .meta { display: flex; gap: 16px; margin-top: 12px; flex-wrap: wrap; }
  .meta-item { font-size: 12px; color: #64748b; }
  .meta-item span { color: #94a3b8; }
  .summary-bar { background: #0f172a; border-radius: 8px; padding: 16px 20px; margin-bottom: 20px; display: flex; gap: 24px; }
  .summary-stat { text-align: center; }
  .summary-stat .num { font-size: 24px; font-weight: 700; color: #f1f5f9; }
  .summary-stat .label { font-size: 11px; color: #64748b; margin-top: 2px; }
  .btn { display: inline-block; background: #f59e0b; color: #000; padding: 10px 20px; border-radius: 8px; text-decoration: none; font-weight: 600; font-size: 13px; margin-top: 16px; }
  .footer { background: #0f172a; padding: 16px 32px; text-align: center; }
  .footer p { color: #475569; font-size: 12px; margin: 0; }
  .firing { color: #ef4444; } .resolved { color: #10b981; }
  hr { border: none; border-top: 1px solid #1e293b; margin: 16px 0; }
</style>
</head>
<body>
<div class="container">
  <!-- Header -->
  <div class="header">
    <h1>🌾 AgriWatch — Système d'Alertes</h1>
    <p>{{ if .Alerts.Firing }}🔴 {{ len .Alerts.Firing }} alerte(s) active(s){{ end }}
       {{ if .Alerts.Resolved }}✅ {{ len .Alerts.Resolved }} résolue(s){{ end }} ·
       Généré le {{ (index .Alerts 0).StartsAt.Format "02/01/2006 15:04" }}</p>
  </div>

  <div class="body">
    <!-- Summary -->
    <div class="summary-bar">
      <div class="summary-stat">
        <div class="num firing">{{ len .Alerts.Firing }}</div>
        <div class="label">Actives</div>
      </div>
      <div class="summary-stat">
        <div class="num resolved">{{ len .Alerts.Resolved }}</div>
        <div class="label">Résolues</div>
      </div>
      <div class="summary-stat">
        <div class="num" style="color:#f59e0b">{{ .GroupLabels.severity | toUpper }}</div>
        <div class="label">Sévérité</div>
      </div>
      <div class="summary-stat">
        <div class="num" style="color:#94a3b8">{{ .GroupLabels.service }}</div>
        <div class="label">Service</div>
      </div>
    </div>

    <!-- Firing Alerts -->
    {{ if .Alerts.Firing }}
    <h3 style="color:#ef4444;font-size:13px;margin:0 0 12px;text-transform:uppercase;letter-spacing:0.05em">🔴 Alertes Actives</h3>
    {{ range .Alerts.Firing }}
    <div class="alert-card {{ .Labels.severity }}">
      <span class="badge badge-{{ .Labels.severity }}">{{ .Labels.severity }}</span>
      <h4 class="alert-title">{{ .Annotations.summary }}</h4>
      <p class="alert-desc">{{ .Annotations.description }}</p>
      <div class="meta">
        <div class="meta-item">Service: <span>{{ .Labels.service }}</span></div>
        <div class="meta-item">Début: <span>{{ .StartsAt.Format "02/01/2006 15:04:05" }}</span></div>
        {{ if .Labels.camera_id }}<div class="meta-item">Caméra: <span>{{ .Labels.camera_id }}</span></div>{{ end }}
      </div>
    </div>
    {{ end }}
    {{ end }}

    <!-- Resolved Alerts -->
    {{ if .Alerts.Resolved }}
    <hr>
    <h3 style="color:#10b981;font-size:13px;margin:0 0 12px;text-transform:uppercase;letter-spacing:0.05em">✅ Alertes Résolues</h3>
    {{ range .Alerts.Resolved }}
    <div class="alert-card" style="border-left-color:#10b981;opacity:0.7">
      <span class="badge badge-resolved">Résolu</span>
      <h4 class="alert-title" style="color:#94a3b8">{{ .Annotations.summary }}</h4>
      <div class="meta">
        <div class="meta-item">Résolu: <span>{{ .EndsAt.Format "02/01/2006 15:04:05" }}</span></div>
        <div class="meta-item">Durée: <span>{{ .EndsAt.Sub .StartsAt | humanizeDuration }}</span></div>
      </div>
    </div>
    {{ end }}
    {{ end }}

    <!-- CTA -->
    <div style="text-align:center;margin-top:24px">
      <a href="http://localhost:3001" class="btn">📊 Voir les Dashboards Grafana</a>
      &nbsp;&nbsp;
      <a href="http://localhost:9090/alerts" class="btn" style="background:#6366f1">🔔 Alertmanager</a>
    </div>
  </div>

  <!-- Footer -->
  <div class="footer">
    <p>AgriWatch Surveillance Agricole · Ce message est automatique · <a href="http://localhost:9093/#/silences/new" style="color:#f59e0b">Silencer cette alerte</a></p>
  </div>
</div>
</body>
</html>
{{ end }}
