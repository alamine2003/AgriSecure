{
  "description": "Métriques métier AgriWatch — caméras, détections IA, agents, WebSocket",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "Surveillance Caméras",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "id": 2,
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "agriwatch_cameras_total{status=\"online\"}", "legendFormat": "En ligne", "refId": "A" }],
      "title": "Caméras En Ligne",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "id": 3,
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "agriwatch_cameras_total{status=\"offline\"}", "legendFormat": "Hors ligne", "refId": "A" }],
      "title": "Caméras Hors Ligne",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "id": 4,
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "agriwatch_active_agents_total", "refId": "A" }],
      "title": "Agents Actifs",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "orange", "value": 5 }] },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "id": 5,
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "agriwatch_pending_registrations_total", "refId": "A" }],
      "title": "Inscriptions en Attente",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "id": 6,
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "agriwatch_websocket_connections_active", "refId": "A" }],
      "title": "Connexions WebSocket",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 10,
      "title": "Détections IA en Temps Réel",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 11,
      "options": {
        "legend": { "calcs": ["mean", "sum"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        { "expr": "rate(agriwatch_detections_total[5m]) * 300", "legendFormat": "{{danger_level}} — {{species}}", "refId": "A" }
      ],
      "title": "Taux Détections / 5min (par niveau de danger)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 12,
      "options": {
        "legend": { "calcs": ["sum"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        { "expr": "increase(agriwatch_detections_total{danger_level=\"HIGH\"}[1h])", "legendFormat": "Haute dangerosité", "refId": "A" },
        { "expr": "increase(agriwatch_detections_total{danger_level=\"MEDIUM\"}[1h])", "legendFormat": "Moyenne dangerosité", "refId": "B" },
        { "expr": "increase(agriwatch_detections_total{danger_level=\"LOW\"}[1h])", "legendFormat": "Faible dangerosité", "refId": "C" }
      ],
      "title": "Détections par Heure (par niveau)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 20,
      "title": "Performance IA — YOLOv8",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.5 }, { "color": "red", "value": 1.0 }] }, "unit": "s" },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 15 },
      "id": 21,
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "histogram_quantile(0.95, rate(agriwatch_yolo_inference_seconds_bucket[5m]))", "legendFormat": "P95", "refId": "A" }
      ],
      "title": "Latence YOLO P95",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 0.3 }, { "color": "green", "value": 0.7 }] }, "unit": "percentunit" },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 15 },
      "id": 22,
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "expr": "rate(agriwatch_frame_cache_hits_total[5m]) / (rate(agriwatch_frame_cache_hits_total[5m]) + rate(agriwatch_frame_cache_misses_total[5m]) + 0.001)",
          "legendFormat": "Hit Rate",
          "refId": "A"
        }
      ],
      "title": "Cache Hit Rate Frames YOLO",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "s" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "id": 23,
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" } },
      "targets": [
        { "expr": "histogram_quantile(0.50, rate(agriwatch_yolo_inference_seconds_bucket[5m]))", "legendFormat": "P50", "refId": "A" },
        { "expr": "histogram_quantile(0.90, rate(agriwatch_yolo_inference_seconds_bucket[5m]))", "legendFormat": "P90", "refId": "B" },
        { "expr": "histogram_quantile(0.95, rate(agriwatch_yolo_inference_seconds_bucket[5m]))", "legendFormat": "P95", "refId": "C" },
        { "expr": "histogram_quantile(0.99, rate(agriwatch_yolo_inference_seconds_bucket[5m]))", "legendFormat": "P99", "refId": "D" }
      ],
      "title": "Distribution Latence YOLO (percentiles)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "reqps" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "id": 24,
      "options": { "legend": { "calcs": ["mean"], "displayMode": "table", "placement": "bottom" } },
      "targets": [
        { "expr": "rate(agriwatch_frame_cache_hits_total[5m])", "legendFormat": "Cache Hits", "refId": "A" },
        { "expr": "rate(agriwatch_frame_cache_misses_total[5m])", "legendFormat": "Cache Misses", "refId": "B" }
      ],
      "title": "Cache Hits vs Misses YOLO",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "id": 30,
      "title": "Alertes Envoyées",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 28 },
      "id": 31,
      "options": { "legend": { "calcs": ["sum"], "displayMode": "table", "placement": "right" } },
      "targets": [
        { "expr": "increase(agriwatch_alerts_sent_total{channel=\"websocket\"}[1h])", "legendFormat": "WebSocket", "refId": "A" },
        { "expr": "increase(agriwatch_alerts_sent_total{channel=\"in_app\"}[1h])", "legendFormat": "In-App", "refId": "B" },
        { "expr": "increase(agriwatch_alerts_sent_total{channel=\"email\"}[1h])", "legendFormat": "Email", "refId": "C" }
      ],
      "title": "Alertes Envoyées par Canal (par heure)",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["agriwatch", "business", "surveillance"],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "type": "datasource",
        "label": "Source"
      }
    ]
  },
  "time": { "from": "now-3h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "AgriWatch — Métriques Métier",
  "uid": "agriwatch-business",
  "version": 1
}
