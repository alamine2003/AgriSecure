# Copier ce fichier en .env et renseigner les valeurs

# Exemples selon environnement :
# Émulateur Android            : EXPO_PUBLIC_API_HOST=10.0.2.2:8000
# Appareil physique même WiFi  : EXPO_PUBLIC_API_HOST=192.168.X.X:8000
# VPS / serveur distant        : EXPO_PUBLIC_API_HOST=monserveur.com ou 185.X.X.X
# Avec nginx sur port 80       : EXPO_PUBLIC_API_HOST=192.168.X.X  (sans :8000)

EXPO_PUBLIC_API_HOST=10.0.2.2:8000
EXPO_PUBLIC_USE_HTTPS=false
