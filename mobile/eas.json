{
  "cli": {
    "version": ">= 13.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_HOST": "10.0.2.2:8000",
        "EXPO_PUBLIC_USE_HTTPS": "false"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_HOST": "172.16.10.242",
        "EXPO_PUBLIC_USE_HTTPS": "false",
        "EXPO_PUBLIC_USE_MOCK": "true"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_API_HOST": "REMPLACER_PAR_DOMAINE_OU_IP",
        "EXPO_PUBLIC_USE_HTTPS": "false"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
